<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="intro_slide1_title">我们开始吧！</string>
    <string name="intro_slide1_desc">欢迎使用 <b>OfflineOTP</b>，本向导将引导您完成初始设置。请谨慎操作并仔细阅读，否则您可能丢失数据！\n\n不用担心，您之后仍可以在 <b>设置</b> 中更改提到的所有选项。 </string>
    <string name="intro_slide2_desc">为保证您的帐户的安全性，<b>OfflineOTP</b> 只将它们存储在加密的数据文件中。您可以在这里选择使用哪种加密方法。</string>
    <string name="intro_slide3_desc_keystore">在此，您可以设置一个身份验证以锁定 <b>OfflineOTP</b>。既然您选择了 <b>Android 密钥库</b> 作为加密方式，这是可选的。</string>
    <string name="intro_slide3_warn_no_password">请设置一个密码以继续</string>
    <string name="intro_slide3_warn_confirm_password">请确认您的密码以继续</string>
    <string name="intro_slide3_warn_password_mismatch">密码必须匹配！</string>
    <string name="intro_slide4_title">已完成</string>
    <string name="intro_slide4_title_failed">设置失败</string>
    <string name="intro_slide4_title_progress">请稍等</string>
    <string name="intro_slide4_desc_failed">设置密码失败，下次还将显示这个入门
        介绍！</string>
    <string name="intro_slide4_desc">您的设置已保存，您现在可以使用 <b>OfflineOTP</b> 啦！</string>
    <string name="intro_slide4_desc_progress">你的设置正被保存，加密密钥正在
        生成中，请等候…</string>
</resources>
