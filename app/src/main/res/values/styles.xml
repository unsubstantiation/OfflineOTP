    <!-- ============================================================================
         Unified Homemade Dark Forest Theme (Theme.OfflineOTP.DarkForest)
         ============================================================================ -->
    <!-- Keep AboutLibraries 14.x: its listitem_opensource is a MaterialCardView. The bridge
         supplies the full Material theme contract while retaining AppCompat widget defaults.
         Every AppTheme hook (including values-v27) must inherit this, not Theme.AppCompat. -->
    <style name="Theme.OfflineOTP.DarkForest" parent="Theme.MaterialComponents.Bridge">
        <item name="isMaterialTheme">true</item>

        <!-- Core Forest & Sage/Emerald Brand Palette -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Surfaces, Backgrounds & On-Colors -->
        <item name="colorSurface">@color/forest_surface</item>
        <item name="colorPrimarySurface">@color/forest_surface</item>
        <item name="colorError">@color/warning_red</item>
        <item name="colorOnPrimary">@color/forest_on_primary</item>
        <item name="colorOnSecondary">@color/forest_on_secondary</item>
        <item name="colorOnBackground">@color/forest_text_primary</item>
        <item name="colorOnSurface">@color/forest_text_primary</item>
        <item name="colorOnPrimarySurface">@color/forest_text_primary</item>
        <item name="colorOnError">@color/forest_on_primary</item>

        <item name="windowBackground">@color/forest_background</item>
        <item name="android:windowBackground">@color/forest_background</item>
        <item name="android:colorBackground">@color/forest_background</item>
        <item name="colorBackgroundFloating">@color/forest_surface_elevated</item>
        <item name="android:colorBackgroundFloating">@color/forest_surface_elevated</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="navigationBarColor">@color/forest_background_deep</item>
        <item name="android:navigationBarColor">@color/forest_background_deep</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Typography & Control Tints -->
        <item name="android:textColorPrimary">@color/forest_text_primary_selector</item>
        <!-- Platform TextView and dropdown styles use this separate disabled-state color. -->
        <item name="android:textColorPrimaryDisableOnly">@color/forest_text_primary_selector</item>
        <item name="android:textColorSecondary">@color/forest_text_secondary_selector</item>
        <item name="android:textColorTertiary">@color/forest_text_hint</item>
        <item name="android:textColorHint">@color/forest_text_hint</item>
        <item name="android:textColorLink">@color/colorAccent</item>
