        <item name="textAppearanceCaption">@style/TextAppearance.OfflineOTP.DarkForest.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.OfflineOTP.DarkForest.Button</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.OfflineOTP.DarkForest.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.OfflineOTP.DarkForest.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.OfflineOTP.DarkForest.LargeComponent</item>

