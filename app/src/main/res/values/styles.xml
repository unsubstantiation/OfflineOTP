        <item name="android:spinnerStyle">@style/Widget.OfflineOTP.DarkForest.Spinner</item>
        <item name="spinnerStyle">@style/Widget.OfflineOTP.DarkForest.Spinner</item>
        <item name="android:popupMenuStyle">@style/Widget.OfflineOTP.DarkForest.PopupMenu</item>
